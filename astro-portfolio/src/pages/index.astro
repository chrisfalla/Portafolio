---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Portafolio Profesional - Diseño de Moda">
  <Navbar />

  <main class="flex-1">

    <!-- HERO -->
    <section id="inicio" class="relative min-h-screen flex items-center overflow-hidden bg-[#1a1a1a]">
      <div class="absolute inset-0">
        <img 
          id="hero-image"
          src="https://images.pexels.com/photos/7679725/pexels-photo-7679725.jpeg?auto=compress&cs=tinysrgb&w=1920" 
          alt="Fashion design studio with sketches" 
          class="w-full h-[120%] object-cover object-center opacity-50 will-change-transform"
          loading="eager"
        />
      </div>

      <div class="relative z-10 max-w-6xl mx-auto px-6 py-20 w-full">
        <div class="max-w-2xl">
          <div class="flex items-center gap-3 mb-6">
            <div class="w-12 h-[2px] bg-[#C9A96E]"></div>
            <p style="color: #C9A96E;" class="font-['Montserrat'] text-sm tracking-[0.4em] uppercase font-medium">Estudiante de Diseño de Modas</p>
          </div>
          
          <h1 class="font-['Cormorant'] text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.95] mb-8">
            <span style="color: white;">Creando</span>
            <span style="color: #C9A96E;" class="block italic">Moda</span>
            <span style="color: white;" class="block">con Identidad</span>
          </h1>
          
          <p style="color: rgba(255,255,255,0.7);" class="text-lg leading-relaxed mb-10 max-w-lg font-['Montserrat']">
            Apasionada por el diseño, el patronaje y la creación de propuestas de vestuario que fusionan creatividad, funcionalidad y tendencia.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <a href="#sobre-mi" class="btn-gold group px-8 py-4 bg-[#C9A96E] font-['Montserrat'] font-medium rounded-full flex items-center gap-2" style="color: #1a1a1a;">
              Conóceme
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="#competencias" class="btn-outline px-8 py-4 border border-white/30 font-['Montserrat'] font-medium rounded-full" style="color: white;">
              Ver habilidades
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
        <span class="text-white/40 text-xs tracking-widest uppercase font-['Montserrat']">Scroll</span>
        <div class="w-[1px] h-12 bg-gradient-to-b from-white/40 to-transparent animate-pulse"></div>
      </div>
    </section>

    <!-- SOBRE MÍ -->
    <section id="sobre-mi" class="py-32 px-6 bg-white reveal">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <!-- Imagen -->
          <div class="relative pt-4 pr-4 pb-20 md:pt-8 md:pr-8">
            <div class="absolute inset-x-0 top-0 bottom-12 rounded-[2rem] bg-[#F5F0EB]"></div>
            <div class="relative aspect-[4/3] rounded-[1.5rem] overflow-hidden shadow-[0_24px_50px_-28px_rgba(26,26,26,0.5)] bg-[#E8E4DF]">
              <img
                src="/images/sobre-mi.jpg"
                alt=""
                aria-hidden="true"
                class="absolute inset-0 h-full w-full scale-110 object-cover opacity-45 blur-2xl"
              />
              <div class="absolute inset-0 bg-[#E8E4DF]/15"></div>
              <img 
                src="/images/sobre-mi.jpg" 
                alt="Foto personal - Estudiante de Diseño de Modas" 
                class="relative z-10 w-full h-full object-contain hover:scale-105 transition-transform duration-700"
                loading="lazy"
              />
              <div class="absolute inset-0 z-20 bg-gradient-to-t from-[#1a1a1a]/70 via-transparent to-[#1a1a1a]/10"></div>
              <div class="absolute top-5 left-5 z-30 flex items-center gap-2 rounded-full border border-white/30 bg-[#E8E4DF]/25 px-4 py-2 backdrop-blur-sm">
                <span class="h-1.5 w-1.5 rounded-full bg-[#C9A96E]"></span>
                <span style="color: #1a1a1a;" class="font-['Montserrat'] text-[10px] font-medium tracking-[0.22em] uppercase">Mi universo creativo</span>
              </div>
              <div class="absolute bottom-5 left-5 right-5 z-30 flex items-end justify-between gap-4">
                <p class="max-w-[13rem] font-['Cormorant'] text-2xl leading-none text-white md:text-3xl">Diseñar con intención.</p>
                <span class="font-['Montserrat'] text-[10px] tracking-[0.2em] text-white/80 uppercase">01 / 04</span>
              </div>
            </div>
            <div class="absolute bottom-0 right-0 flex items-center gap-3 rounded-2xl border border-[#E8E4DF] bg-white px-4 py-3 shadow-lg shadow-[#1a1a1a]/5">
              <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#C9A96E] text-lg text-white">✦</div>
              <div>
                <p class="font-['Montserrat'] text-[10px] font-medium tracking-[0.16em] text-[#C9A96E] uppercase">Moda</p>
                <p class="font-['Cormorant'] text-lg font-semibold leading-none text-[#1a1a1a]">en evolución</p>
              </div>
            </div>
            <div aria-hidden="true" class="absolute -top-2 left-8 font-['Cormorant'] text-7xl leading-none text-[#C9A96E]/25 md:text-8xl">01</div>
          </div>

          <!-- Contenido -->
          <div>
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-[2px] bg-[#C9A96E]"></div>
              <p class="text-[#C9A96E] font-['Montserrat'] text-xs tracking-[0.3em] uppercase font-medium">Mi historia</p>
            </div>
            
            <h2 class="font-['Cormorant'] text-4xl md:text-5xl font-bold text-[#1a1a1a] mb-8">
              Sobre <span class="italic text-[#C9A96E]">Mí</span>
            </h2>
            
            <p class="text-[#4a4a4a] text-lg leading-relaxed mb-6 font-['Montserrat']">
              Soy estudiante de Diseño de Moda en la CUN, interesada en desarrollar mi creatividad y fortalecer mis conocimientos técnicos en el diseño, patronaje y confección de prendas.
            </p>
            <p class="text-[#4a4a4a] text-lg leading-relaxed mb-8 font-['Montserrat']">
              Durante mi formación he desarrollado bocetos, procesos de maquinaria y fichas técnicas. Mi área de interés profesional se enfoca en el diseño de moda femenina, la creación de colecciones, la investigación de tendencias y el desarrollo de propuestas inspiradas en las necesidades actuales.
            </p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-3 mb-10">
              <span class="px-5 py-2.5 bg-[#F5F0EB] text-[#4a4a4a] text-sm rounded-full font-['Montserrat']">Diseño de Moda</span>
              <span class="px-5 py-2.5 bg-[#F5F0EB] text-[#4a4a4a] text-sm rounded-full font-['Montserrat']">Patronaje</span>
              <span class="px-5 py-2.5 bg-[#F5F0EB] text-[#4a4a4a] text-sm rounded-full font-['Montserrat']">Confección</span>
              <span class="px-5 py-2.5 bg-[#F5F0EB] text-[#4a4a4a] text-sm rounded-full font-['Montserrat']">Fichas Técnicas</span>
              <span class="px-5 py-2.5 bg-[#F5F0EB] text-[#4a4a4a] text-sm rounded-full font-['Montserrat']">Tendencias</span>
            </div>

            <!-- Stats -->
            <div class="grid grid-cols-3 gap-6">
              <div class="text-center p-4 bg-[#F5F0EB] rounded-2xl">
                <p class="font-['Cormorant'] text-2xl font-bold text-[#C9A96E]">CUN</p>
                <p class="text-xs text-[#4a4a4a] mt-1 font-['Montserrat']">Institución</p>
              </div>
              <div class="text-center p-4 bg-[#F5F0EB] rounded-2xl">
                <p class="font-['Cormorant'] text-2xl font-bold text-[#C9A96E]">Diseño</p>
                <p class="text-xs text-[#4a4a4a] mt-1 font-['Montserrat']">de Moda</p>
              </div>
              <div class="text-center p-4 bg-[#F5F0EB] rounded-2xl">
                <p class="font-['Cormorant'] text-2xl font-bold text-[#C9A96E]">Proceso</p>
                <p class="text-xs text-[#4a4a4a] mt-1 font-['Montserrat']">formativo</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- COMPETENCIAS -->
    <section id="competencias" class="py-32 px-6 bg-[#F5F0EB] reveal">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-20">
          <div class="flex items-center justify-center gap-3 mb-4">
            <div class="w-12 h-[2px] bg-[#C9A96E]"></div>
            <p class="text-[#C9A96E] font-['Montserrat'] text-xs tracking-[0.3em] uppercase font-medium">Lo que sé hacer</p>
            <div class="w-12 h-[2px] bg-[#C9A96E]"></div>
          </div>
          <h2 class="font-['Cormorant'] text-4xl md:text-5xl font-bold text-[#1a1a1a]">
            Competencias <span class="italic text-[#C9A96E]">&</span> Herramientas
          </h2>
        </div>

        <!-- Habilidades Blandas -->
        <div class="mb-20">
          <h3 class="font-['Cormorant'] text-2xl font-semibold text-[#1a1a1a] mb-10 text-center">Habilidades</h3>
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <!-- Creatividad -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/8527897/pexels-photo-8527897.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Creatividad" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Creatividad</p>
              </div>
            </div>

            <!-- Dibujo -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/1109354/pexels-photo-1109354.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Dibujo" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Dibujo</p>
              </div>
            </div>

            <!-- Moodboards -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/6931845/pexels-photo-6931845.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Moodboards" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Moodboards</p>
              </div>
            </div>

            <!-- Color -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/593333/pexels-photo-593333.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Color" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Color</p>
              </div>
            </div>

            <!-- Patronaje -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/9850428/pexels-photo-9850428.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Patronaje" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.121 14.121L19 19m-7-7l7-7m-7 7l-2.879 2.879M12 12L9.121 9.121m0 5.758a3 3 0 10-4.243 4.243 3 3 0 004.243-4.243zm0-5.758a3 3 0 10-4.243-4.243 3 3 0 004.243 4.243z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Patronaje</p>
              </div>
            </div>

            <!-- Confección -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/6461151/pexels-photo-6461151.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Confección" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Confección</p>
              </div>
            </div>

            <!-- Tendencias -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/1536619/pexels-photo-1536619.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Tendencias" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Tendencias</p>
              </div>
            </div>

            <!-- Conceptos -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/6373478/pexels-photo-6373478.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Conceptos" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Conceptos</p>
              </div>
            </div>

            <!-- Detalle -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/5908326/pexels-photo-5908326.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Detalle" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Detalle</p>
              </div>
            </div>

            <!-- Comunicación -->
            <div class="group relative h-56 rounded-2xl overflow-hidden cursor-pointer">
              <img src="https://images.pexels.com/photos/3184291/pexels-photo-3184291.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Comunicación" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a]/90 via-[#1a1a1a]/50 to-transparent"></div>
              <div class="absolute inset-0 flex flex-col items-center justify-end p-5">
                <svg class="w-8 h-8 text-[#C9A96E] mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" />
                </svg>
                <p class="text-sm font-medium text-white font-['Montserrat']">Comunicación</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Herramientas Digitales -->
        <div>
          <h3 class="font-['Cormorant'] text-2xl font-semibold text-[#1a1a1a] mb-10 text-center">Herramientas Digitales</h3>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div class="group bg-white rounded-3xl p-8 hover:shadow-xl transition-all duration-300 border border-[#E8E4DF]">
              <div class="w-14 h-14 bg-gradient-to-br from-[#C9A96E] to-[#A67C52] rounded-2xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="currentColor">
