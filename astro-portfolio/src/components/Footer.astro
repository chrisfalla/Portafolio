---
---

<footer class="bg-[#1a1a1a] border-t border-[#2a2a2a]">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row items-center justify-between gap-10">
      <div class="text-center md:text-left">
        <p class="font-['Cormorant'] text-2xl font-semibold text-white mb-2">Portfolio</p>
        <p class="text-sm text-white/50 font-['Montserrat']">Estudiante de Diseño de Modas</p>
      </div>

      <div class="flex items-center gap-5">
        <!-- Instagram -->
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 bg-[#2a2a2a] rounded-full flex items-center justify-center text-white/60 hover:bg-[#C9A96E] hover:text-[#1a1a1a] transition-all duration-300 hover:scale-110"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
        <!-- TikTok -->
        <a
          href="https://tiktok.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 bg-[#2a2a2a] rounded-full flex items-center justify-center text-white/60 hover:bg-[#C9A96E] hover:text-[#1a1a1a] transition-all duration-300 hover:scale-110"
          aria-label="TikTok"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1v-3.51a6.37 6.37 0 0 0-.79-.05A6.34 6.34 0 0 0 3.15 15a6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.34-6.34V8.87a8.16 8.16 0 0 0 4.76 1.52v-3.4a4.85 4.85 0 0 1-1-.3z"/>
          </svg>
        </a>
        <!-- Pinterest -->
        <a
          href="https://pinterest.com"
          target="_blank"
          rel="noopener noreferrer"
          class="w-12 h-12 bg-[#2a2a2a] rounded-full flex items-center justify-center text-white/60 hover:bg-[#C9A96E] hover:text-[#1a1a1a] transition-all duration-300 hover:scale-110"
          aria-label="Pinterest"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.08 3.15 9.42 7.6 11.18-.1-.95-.2-2.4.04-3.44.22-.94 1.4-5.94 1.4-5.94s-.36-.71-.36-1.77c0-1.66.96-2.9 2.16-2.9 1.02 0 1.51.77 1.51 1.68 0 1.03-.65 2.56-.99 3.98-.28 1.19.6 2.16 1.77 2.16 2.13 0 3.77-2.25 3.77-5.49 0-2.87-2.06-4.87-5-4.87-3.41 0-5.41 2.56-5.41 5.2 0 1.03.4 2.13.89 2.73.1.12.11.22.08.34-.09.37-.29 1.19-.33 1.36-.05.22-.18.27-.41.16-1.52-.71-2.47-2.93-2.47-4.72 0-3.84 2.79-7.37 8.03-7.37 4.21 0 7.49 3 7.49 7 0 4.18-2.63 7.54-6.28 7.54-1.23 0-2.38-.64-2.77-1.39l-.76 2.88c-.27 1.06-1.01 2.4-1.51 3.21C9.58 23.81 10.77 24 12 24c6.63 0 12-5.37 12-12S18.63 0 12 0z"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="border-t border-[#2a2a2a] mt-10 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-white/30 font-['Montserrat']">
        &copy; {new Date().getFullYear()} Diana Pinto, Daniela Gamez, Jazmin Ochoa. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-6">
        <a href="#inicio" class="text-xs text-white/40 hover:text-[#C9A96E] transition-colors font-['Montserrat']">Inicio</a>
        <a href="#sobre-mi" class="text-xs text-white/40 hover:text-[#C9A96E] transition-colors font-['Montserrat']">Sobre Mí</a>
        <a href="#competencias" class="text-xs text-white/40 hover:text-[#C9A96E] transition-colors font-['Montserrat']">Competencias</a>
        <a href="#proyeccion" class="text-xs text-white/40 hover:text-[#C9A96E] transition-colors font-['Montserrat']">Proyección</a>
      </div>
    </div>
  </div>
</footer>
